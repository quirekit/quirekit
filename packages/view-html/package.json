{
  "name": "@quirekit/view-html",
  "version": "0.0.1-alpha.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quirekit/quirekit.git",
    "directory": "packages/view-html"
  },
  "homepage": "https://github.com/quirekit/quirekit/tree/main/packages/view-html#readme",
  "bugs": "https://github.com/quirekit/quirekit/issues",
  "description": "QuireKit continuous-flow HTML backend for the mounted editor view.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src"
  },
  "dependencies": {
    "@quirekit/clipboard": "workspace:*",
    "@quirekit/core": "workspace:*",
    "@quirekit/layout": "workspace:*",
    "@quirekit/pm": "workspace:*",
    "@quirekit/renderer": "workspace:*",
    "@quirekit/ui": "workspace:*",
    "@quirekit/view": "workspace:*",
    "@quirekit/view-engine": "workspace:*"
  },
  "devDependencies": {
    "@quirekit/extension-text-style": "workspace:*",
    "@quirekit/starter-kit": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.1.0",
    "vitest": "catalog:"
  }
}
