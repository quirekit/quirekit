{
  "name": "@quirekit/incremark-core",
  "version": "0.0.1-alpha.2",
  "description": "Framework-neutral incremental Markdown parsing and semantic reading.",
  "type": "module",
  "license": "MIT",
  "repository": {"type":"git","url":"git+https://github.com/quirekit/quirekit.git","directory":"packages/incremark-core"},
  "homepage": "https://github.com/quirekit/quirekit/tree/main/packages/incremark-core#readme",
  "bugs": "https://github.com/quirekit/quirekit/issues",
  "sideEffects": false,
  "files": [
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src"
  },
  "dependencies": {
    "@quirekit/cm-state": "workspace:*",
    "@quirekit/cm-language": "workspace:*",
    "@quirekit/msfe-core": "workspace:*",
    "@quirekit/msfe-markdown-extras": "workspace:*",
    "@lezer/common": "1.5.3",
    "@quirekit/lezer-markdown": "workspace:*",
    "@lezer/html": "1.3.13",
    "hast-util-from-html": "2.0.3",
    "hast-util-sanitize": "5.0.2",
    "@quirekit/text-diagram": "workspace:*"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
