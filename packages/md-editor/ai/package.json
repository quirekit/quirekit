    "@quirekit/md-editor": "workspace:*",
    "@quirekit/mind-editor": "workspace:*",
    "@quirekit/msfe-ai": "workspace:*",
    "@quirekit/msfe-core": "workspace:*",
    "@quirekit/msfe-flowchart": "workspace:*",
    "@quirekit/msfe-mind-map": "workspace:*",
    "@quirekit/ui": "workspace:*",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "3.5.40",
