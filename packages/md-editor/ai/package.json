  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quirekit/quirekit.git",
    "directory": "packages/md-editor/ai"
  },
  "homepage": "https://github.com/quirekit/quirekit/tree/main/packages/md-editor/ai#readme",
  "bugs": "https://github.com/quirekit/quirekit/issues",
  "description": "First-party AI assistant panel for md-editor: Markdown document SDK, conversation workspace and model settings.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --out-dir dist",
