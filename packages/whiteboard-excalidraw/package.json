{
  "name": "@quirekit/whiteboard-excalidraw",
  "version": "0.0.1-alpha.2",
  "description": "Excalidraw adapter for QuireKit whiteboard documents: editing, snapshots and scene rendering.",
  "license": "MIT",
  "repository": {"type":"git","url":"git+https://github.com/quirekit/quirekit.git","directory":"packages/whiteboard-excalidraw"},
  "homepage": "https://github.com/quirekit/quirekit/tree/main/packages/whiteboard-excalidraw#readme",
  "bugs": "https://github.com/quirekit/quirekit/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "src",
    "licenses"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src"
  },
  "dependencies": {
    "@quirekit/whiteboard": "workspace:*",
    "@excalidraw/excalidraw": "0.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
