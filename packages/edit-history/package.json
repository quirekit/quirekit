{
  "name": "@quirekit/edit-history",
  "version": "0.0.1-alpha.2",
  "description": "Storage-neutral activity record protocol: confirmed edit events, versions, retention, conformance tests and timeline projection.",
  "license": "MIT",
  "repository": {"type":"git","url":"git+https://github.com/quirekit/quirekit.git","directory":"packages/edit-history"},
  "homepage": "https://github.com/quirekit/quirekit/tree/main/packages/edit-history#readme",
  "bugs": "https://github.com/quirekit/quirekit/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./memory": {
      "types": "./dist/memory/index.d.mts",
      "import": "./dist/memory/index.mjs"
    },
    "./writer": {
      "types": "./dist/writer/index.d.mts",
      "import": "./dist/writer/index.mjs"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.mts",
      "import": "./dist/conformance/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown src/index.ts src/memory/index.ts src/writer/index.ts src/conformance/index.ts --format esm --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
