{
  "name": "@quirekit/mind-editor",
  "version": "0.0.1-alpha.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quirekit/quirekit.git",
    "directory": "packages/mind-editor"
  },
  "homepage": "https://github.com/quirekit/quirekit/tree/main/packages/mind-editor#readme",
  "bugs": "https://github.com/quirekit/quirekit/issues",
  "description": "Quire Mind: a shared mind map editor with IME, Toolbar and themed infinite canvas.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vue": {
      "types": "./dist/vue.d.mts",
      "import": "./dist/vue.mjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run src",
    "dev": "vite --config test-support/vite.config.ts",
    "test:browser": "playwright test --config test-support/playwright.config.ts",
    "test:browser:matrix": "playwright test --config test-support/matrix.config.ts"
  },
  "dependencies": {
    "@quirekit/mind-map": "workspace:*",
    "@quirekit/mind-map-simple": "workspace:*",
    "@quirekit/ui": "workspace:*",
    "pdf-lib": "1.17.1",
    "uuid": "14.0.3"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tsdown/css": "catalog:",
    "@ark-ui/vue": "5.39.1",
    "@playwright/test": "1.61.1",
    "@quirekit/unocss-preset": "workspace:*",
    "@unocss/vite": "catalog:",
    "@vitejs/plugin-vue": "^6.0.7",
    "happy-dom": "20.10.6",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-vue": "^7.2.0",
    "vite": "^8.1.0",
    "vitest": "catalog:",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  }
}
