    "@quirekit/cm-state": "workspace:*",
    "@quirekit/cm-language": "workspace:*"
  },
  "devDependencies": {
    "@quirekit/cm-lang-markdown": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
