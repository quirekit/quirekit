{
  "name": "@quirekit/incremark-react",
  "version": "0.0.1-alpha.2",
  "description": "React Markdown reading and incremental streaming over QuireKit Lezer.",
  "type": "module",
  "license": "MIT",
  "repository": {"type":"git","url":"git+https://github.com/quirekit/quirekit.git","directory":"packages/incremark-react"},
  "homepage": "https://github.com/quirekit/quirekit/tree/main/packages/incremark-react#readme",
  "bugs": "https://github.com/quirekit/quirekit/issues",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && node ../../scripts/incremark/copy-fonts.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src"
  },
  "dependencies": {
    "@quirekit/incremark-core": "workspace:*",
    "@quirekit/msfe-core": "workspace:*",
    "@quirekit/msfe-markdown-extras": "workspace:*",
    "@quirekit/cm-state": "workspace:*",
    "katex": "0.16.47",
    "@lezer/common": "1.5.3"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "happy-dom": "20.10.6",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
