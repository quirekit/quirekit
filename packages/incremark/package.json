{
  "name": "@quirekit/incremark",
  "version": "0.0.1-alpha.2",
  "description": "Streaming Markdown sessions and extensible Vue reading with QuireKit Lezer.",
  "type": "module",
  "license": "MIT",
  "repository": {"type":"git","url":"git+https://github.com/quirekit/quirekit.git","directory":"packages/incremark"},
  "homepage": "https://github.com/quirekit/quirekit/tree/main/packages/incremark#readme",
  "bugs": "https://github.com/quirekit/quirekit/issues",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vue": {
      "types": "./dist/vue.d.mts",
      "import": "./dist/vue.mjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run src"
  },
  "dependencies": {
    "@quirekit/cm-state": "workspace:*",
    "@quirekit/msfe-core": "workspace:*",
    "@quirekit/msfe-markdown-extras": "workspace:*",
    "@quirekit/ui": "workspace:*",
    "@lezer/common": "1.5.3",
    "katex": "0.16.47",
    "@quirekit/incremark-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tsdown/css": "catalog:",
    "happy-dom": "20.10.6",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-vue": "^7.2.0",
    "vite": "^8.1.0",
    "vitest": "catalog:",
    "vue": "3.5.40",
    "vue-tsc": "^3.3.7",
    "@quirekit/lezer-markdown": "workspace:*",
    "@quirekit/cm-language": "workspace:*"
  }
}
