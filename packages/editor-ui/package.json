{
  "name": "@quirekit/editor-ui",
  "version": "0.0.1-alpha.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quirekit/quirekit.git",
    "directory": "packages/editor-ui"
  },
  "homepage": "https://github.com/quirekit/quirekit/tree/main/packages/editor-ui#readme",
  "bugs": "https://github.com/quirekit/quirekit/issues",
  "description": "Headless editor-aware UI controllers shared by QuireKit products and mounted views.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vue": {
      "types": "./dist/vue.d.mts",
      "import": "./dist/vue.mjs"
    },
    "./styles.css": "./dist/vue.css"
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run src"
  },
  "dependencies": {
    "@quirekit/core": "workspace:*",
    "@quirekit/extensions": "workspace:*",
    "@quirekit/extension-underline": "workspace:*",
    "@quirekit/suggestion": "workspace:*",
    "@quirekit/view-engine": "workspace:*",
    "@quirekit/ui": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "3.5.40",
    "vue-tsc": "^3.3.7",
    "unplugin-vue": "^7.2.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
