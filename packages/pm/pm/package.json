{
  "name": "@quirekit/pm",
  "version": "0.0.1-alpha.2",
  "license": "MIT",
  "repository": {"type":"git","url":"git+https://github.com/quirekit/quirekit.git","directory":"packages/pm/pm"},
  "homepage": "https://github.com/quirekit/quirekit/tree/main/packages/pm/pm#readme",
  "bugs": "https://github.com/quirekit/quirekit/issues",
  "description": "Aggregate QuireKit ProseMirror compatibility exports.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src"
  },
  "dependencies": {
    "@quirekit/pm-collab": "workspace:*",
    "@quirekit/pm-commands": "workspace:*",
    "@quirekit/pm-decoration": "workspace:*",
    "@quirekit/pm-gapcursor": "workspace:*",
    "@quirekit/pm-history": "workspace:*",
    "@quirekit/pm-inputrules": "workspace:*",
    "@quirekit/pm-keymap": "workspace:*",
    "@quirekit/pm-model": "workspace:*",
    "@quirekit/pm-schema-list": "workspace:*",
    "@quirekit/pm-state": "workspace:*",
    "@quirekit/pm-transform": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
