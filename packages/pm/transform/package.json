  "description": "QuireKit vendored ProseMirror transform boundary.",
  "license": "MIT",
  "repository": {"type":"git","url":"git+https://github.com/quirekit/quirekit.git","directory":"packages/pm/transform"},
  "homepage": "https://github.com/quirekit/quirekit/tree/main/packages/pm/transform#readme",
  "bugs": "https://github.com/quirekit/quirekit/issues",
  "type": "module",
