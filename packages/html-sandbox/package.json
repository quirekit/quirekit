{
  "name": "@quirekit/html-sandbox",
  "version": "0.0.1-alpha.2",
  "license": "MIT",
  "repository": {"type":"git","url":"git+https://github.com/quirekit/quirekit.git","directory":"packages/html-sandbox"},
  "homepage": "https://github.com/quirekit/quirekit/tree/main/packages/html-sandbox#readme",
  "bugs": "https://github.com/quirekit/quirekit/issues",
  "description": "Framework-neutral isolated HTML execution with explicit lifecycle and resource policy.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs"
    },
    "./markdown": {
      "types": "./dist/markdown.d.mts",
      "import": "./dist/markdown.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && node scripts/runner.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
