  "description": "Incremental Markdown parser that consumes and emits Lezer trees",
  "license": "MIT",
  "repository": {"type":"git","url":"git+https://github.com/quirekit/quirekit.git","directory":"packages/lezer-markdown"},
  "homepage": "https://github.com/quirekit/quirekit/tree/main/packages/lezer-markdown#readme",
  "bugs": "https://github.com/quirekit/quirekit/issues",
