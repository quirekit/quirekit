{
  "name": "@quirekit/mind-map",
  "version": "0.0.1-alpha.2",
  "license": "MIT",
  "repository": {"type":"git","url":"git+https://github.com/quirekit/quirekit.git","directory":"packages/mind-map"},
  "homepage": "https://github.com/quirekit/quirekit/tree/main/packages/mind-map#readme",
  "bugs": "https://github.com/quirekit/quirekit/issues",
  "description": "Renderer-neutral mind map documents, validation and atomic draft contracts.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./xmind": {
      "types": "./dist/xmind/index.d.mts",
      "import": "./dist/xmind/index.mjs"
    },
    "./text": {
      "types": "./dist/text/index.d.mts",
      "import": "./dist/text/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown src/index.ts src/xmind/index.ts src/text/index.ts --format esm --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src test-support/native-xmind.test.ts"
  },
  "dependencies": {
    "fast-xml-parser": "5.10.1",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
